{
  "name": "word-hopper",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "version": "1.0.0",
  "description": "A hopping browser game for word typing practice — type to jump, chase your WPM.",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "generate:words": "python3 scripts/generate-word-data.py",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:py": "ruff check server/ && ruff format --check server/"
  },
  "keywords": [
    "typing-game",
    "phaser",
    "wpm",
    "browser-game",
    "word-game"
  ],
  "author": "WingEdge777",
  "license": "ISC",
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "happy-dom": "^20.10.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}
